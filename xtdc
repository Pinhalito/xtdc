xtdc_carga(){
if [ -f /bin/xtdc ]; then
    source /bin/xtdc
notify-send -t 3000 -i dialog-information "XTDC" "Funções carregadas em: $(date +%H:%M:%S)"
fi
}


xtdc_norma(){
    local nome=${1::-4}
    ffmpeg-normalize "$1" -c:a aac -b:a 192k -o "${nome}alto.mp4"
    rm -rf "$1"
}


xtdc_printa(){
    local agora=$(date +%Y_%m_%d_%H_%M_%S)
    local destino="${HOME}/Imagens/PRINTS"
    mkdir -p "$destino"
    local temp_file=$(mktemp "/tmp/temporario_XXXXXX.png")

    xfce4-screenshooter -rc -s "$temp_file" 2>/dev/null || {
        rm -f "$temp_file"
        notify-send -t 1500 -i dialog-error "Captura Cancelada" "Operação interrompida"
        return 0
    }
    if [[ -s "$temp_file" ]]; then
        local novo_arquivo="${destino}/captura_de_tela_${agora}.png"
        mv "$temp_file" "$novo_arquivo" && {
            notify-send -t 1500 -i camera-photo "Captura de Tela" "Salva em:\n${novo_arquivo}"
        }
    else
        rm -f "$temp_file"
        notify-send -t 1500 -i dialog-error "Captura Cancelada" "Nenhuma região selecionada"
    fi
}


xtdc_hist(){
strings -n 4 ~/.local/share/clipit/history > "$HOME/Documentos/historicos/$(date +'%Y_%m_%d_%H_%M_%S')_historico.txt"

cp ~/.bash_history "$HOME/Documentos/historicos/$(date +'%Y_%m_%d_%H_%M_%S')_bash_history.txt"

journalctl -b 0 > "$HOME/Documentos/historicos/$(date +'%Y_%m_%d_%H_%M_%S')_boot.txt"
journalctl -b 0 -p 3 --no-pager > "$HOME/Documentos/historicos/$(date +'%Y_%m_%d_%H_%M_%S')_apenas_erros.txt"
}


