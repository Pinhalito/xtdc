xtdc_list_unique_mimetypes() {
    local dir="$1"
    declare -A mime_types  # Usamos um array associativo para evitar duplicatas

    if [[ ! -d "$dir" ]]; then
        echo "Erro: Diretório '$dir' não existe." >&2
        return 1
    fi

    # Processa cada arquivo no diretório
    for file in "$dir"/*; do
        if [[ -f "$file" ]]; then
            mimetype=$(xdg-mime query filetype "$file" 2>/dev/null)
            if [[ -n "$mimetype" ]]; then
                mime_types["$mimetype"]=1  # Armazena no array (chaves únicas)
            fi
        fi
    done

    # Imprime os resultados únicos
    printf "%s\n" "${!mime_types[@]}" | sort
}


xtdc_lista_arquivos() {
    cd "$1/.." || exit  # Sobe um nível
    NOME_PASTA=$(basename "$1")
