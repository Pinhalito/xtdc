# =================================================⚡
xtdc_bkp() {
DIRETORIOS=(
    "/mnt/DOIS/NOVOXTDC/CUBIC2/custom-root/etc/skel"
    "/mnt/DOIS/NOVOXTDC/CUBIC2/custom-root/usr/share/themes/xtdc_theme"
    "/mnt/DOIS/NOVOXTDC/CUBIC2/custom-root/usr/share/icons/xtdc_icons"
    "/mnt/DOIS/NOVOXTDC/CUBIC2/custom-root/usr/share/fonts/truetype/xtdc_ttf"
)

# Nome do arquivo de backup com timestamp
BACKUP_FILE="/xtdc/xtdc_bkp_$(date +'%Y_%m_%d_%H_%M_%S').tar.gz"

# Mostra os diretórios que serão incluídos no backup
echo "=============================================="
echo "DIRETÓRIOS QUE SERÃO INCLUÍDOS NO BACKUP:"
echo "----------------------------------------------"
for dir in "${DIRETORIOS[@]}"; do
    echo "- $dir"
done
echo "=============================================="
echo ""

# Pede confirmação antes de continuar
read -p "Deseja continuar e criar o backup? (s/n) " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Ss]$ ]]; then
    echo "Backup cancelado pelo usuário."
    exit 1
fi

echo "Criando backup: $BACKUP_FILE"
tar -czf "$BACKUP_FILE" "${DIRETORIOS[@]}"

# Verifica se o backup foi criado com sucesso
if [ $? -eq 0 ]; then
    echo "Backup criado com sucesso!"
    echo "Tamanho do arquivo: $(du -h "$BACKUP_FILE" | cut -f1)"
else
    echo "Erro ao criar o backup!"
    exit 1
fi
}

xtdc_bkp2() {
    # Define o nome do arquivo com timestamp
    local timestamp=$(date +"%Y_%m_%d_%H_%M_%S")
    local output_file="/xtdc/xtdc_bkp_${timestamp}.tar.gz"

    # Lista de arquivos/diretórios para incluir
    local items_to_include=(
        "/etc/skel"
        "/usr/share/icons/xtdc_icons"
        "/usr/share/themes/xtdc_theme"
        "/usr/share/themes/xtdc_dark"
        "/usr/share/fonts/truetype/xtdc_ttf"
        "/bin/xtdc"
    )
    echo "📦 Criando arquivo $output_file..."
    tar -czf "$output_file" "${items_to_include[@]}"
    echo "✅ Arquivo criado: $output_file"
}

xtdc_update_from_tar() {
    local timestamp=$(date +"%Y_%m_%d_%H_%M_%S")
    local downloaded_file="/xtdc/xtdc_zip_${timestamp}.tar.gz"
    local tar_url="https://raw.githubusercontent.com/Pinhalito/xtdc/refs/heads/main/xtdc_zip.tar.gz"
    echo "⬇️ Baixando arquivo de $tar_url..."
    wget -q "$tar_url" -O "$downloaded_file"
    echo "Arquivo baixado: $downloaded_file"
    echo "📦 Extraindo arquivos..."
    sudo tar -xzf "$downloaded_file" -C /
    echo "✅ Atualização concluída!"
}


