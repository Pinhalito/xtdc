    tree "$NOME_PASTA" > "${NOME_PASTA}_listadearquivos_${DATA}.txt"
    xfce4-terminal -e "cat ${NOME_PASTA}_listadearquivos_${DATA}.txt"
}


xtdc_zipa() {
# Verifica se o diretório foi passado como argumento
if [ -z "$1" ]; then
    notify-send "Erro" "Nenhum diretório selecionado."
    exit 1
fi

# Obtém o nome do diretório sem o caminho completo
NOME_PASTA=$(basename "$1")
CAMINHO_PASTA=$(dirname "$1")
ARQUIVO_TAR="$CAMINHO_PASTA/$NOME_PASTA.tar.gz"
ARQUIVO_TAR_TEMP="$CAMINHO_PASTA/$NOME_PASTA.tar.gz.temp"

# Verifica se o arquivo tar.gz já existe
if [ -f "$ARQUIVO_TAR" ]; then
    # Modo incremental - extrai, atualiza e compacta novamente
    #notify-send "Compactação Incremental" "Atualizando $NOME_PASTA.tar.gz com arquivos novos/modificados..."
    
    # 1. Descompacta o arquivo existente para uma pasta temporária
    TEMP_DIR=$(mktemp -d)
    tar -xzf "$ARQUIVO_TAR" -C "$TEMP_DIR"
    
    # 2. Atualiza os arquivos na pasta temporária com os mais recentes
    rsync -a --update "$1/" "$TEMP_DIR/$NOME_PASTA/"
    
    # 3. Cria um novo arquivo tar.gz com o conteúdo atualizado
    tar -czf "$ARQUIVO_TAR_TEMP" -C "$TEMP_DIR" "$NOME_PASTA"
    
    # 4. Substitui o arquivo antigo pelo novo
    mv "$ARQUIVO_TAR_TEMP" "$ARQUIVO_TAR"
    
    # 5. Limpa a pasta temporária
    rm -rf "$TEMP_DIR"
else
    # Cria um novo arquivo compactado
  #  notify-send "Compactação" "Criando novo arquivo $NOME_PASTA.tar.gz..."
    tar -czf "$ARQUIVO_TAR" -C "$CAMINHO_PASTA" "$NOME_PASTA"
fi

notify-send "Concluído" "Operação de compactação finalizada para $NOME_PASTA"
}


